# Chave da API da Anthropic (console.anthropic.com) — obrigatória para a leitura automática do print
ANTHROPIC_API_KEY=sk-ant-...

# Connection string do banco Neon (neon.tech) — obrigatória para os dados serem salvos
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx.neon.tech/neondb?sslmode=require

# Senha para proteger o acesso ao app (opcional, mas recomendado já que vai ser enviado a um cliente)
APP_PASSWORD=escolha-uma-senha

# Porta (a maioria das hospedagens define isso automaticamente, pode deixar em branco)
PORT=3000
